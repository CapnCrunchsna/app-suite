{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../libs/ledgerline/llm/tsconfig.lib.json"
    },
    {
      "path": "../../libs/ledgerline/data/tsconfig.lib.json"
    },
    {
      "path": "../../libs/ledgerline/analyzers/tsconfig.lib.json"
    },
    {
      "path": "../../libs/ledgerline/normalize/tsconfig.lib.json"
    },
    {
      "path": "../../libs/ledgerline/parsing/tsconfig.lib.json"
    },
    {
      "path": "../../libs/ledgerline/domain/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ]
}
