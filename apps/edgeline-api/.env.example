# Copy to .env (gitignored) and fill in. Spec §3.1.
# Secrets live here ONLY — never in Elasticsearch, never in git.

# The Odds API key — https://the-odds-api.com (free tier is enough for Phase 0-1)
ODDS_API_KEY=
# More keys for the same provider, comma-separated, spent after ODDS_API_KEY in this order.
# Two free-tier keys are one 1,000-credit pool: the first is spent until the provider reports
# nothing left (or refuses it as spent), then the next. Raise quota_monthly_budget (§3.2) to
# the pool's size, or the pace guard stops at the first key's 500. Either variable alone works.
ODDS_API_KEYS=

# Discord bot token and the numeric channel id alerts are posted to (Phase 2)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Local single-node Elasticsearch started by `nx run edgeline-api:es-up`
ES_URL=http://localhost:9200
