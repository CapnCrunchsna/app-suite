{
  "name": "edgeline-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/edgeline-api/src",
  "projectType": "application",
  "tags": ["scope:el", "type:app"],
  "metadata": {
    "description": "Edgeline engine (Python/uv). Targets are named *-py on purpose: `npm run check` runs lint/typecheck/test/build across the workspace, and these shell through uv — see README.md for when to rename test-py to test.",
    "technologies": ["python"]
  },
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run uvicorn edgeline.api.main:app --reload --port 8000"
      }
    },
    "worker": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run python -m edgeline.scheduler"
      }
    },
    "test-py": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "uv run pytest"
      }
    },
    "es-up": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "docker compose up -d"
      }
    },
    "es-down": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "docker compose down"
      }
    }
  }
}
