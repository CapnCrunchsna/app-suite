{
  "openapi": "3.1.0",
  "info": {
    "title": "Edgeline API",
    "summary": "Sports betting intelligence. Recommends bets; never places them.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Read Settings",
        "description": "The full §3.2 map, defaults filled in for anything unseeded.",
        "operationId": "getSettings",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Update Settings",
        "operationId": "updateSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Patch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/providers": {
      "get": {
        "tags": [
          "providers"
        ],
        "summary": "List Providers",
        "operationId": "listProviders",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProviderRow"
                  },
                  "type": "array",
                  "title": "Response Listproviders"
                }
              }
            }
          }
        }
      }
    },
    "/api/providers/{key}": {
      "patch": {
        "tags": [
          "providers"
        ],
        "summary": "Patch Provider",
        "operationId": "patchProvider",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderRow"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sportsbooks": {
      "get": {
        "tags": [
          "sportsbooks"
        ],
        "summary": "List Sportsbooks",
        "operationId": "listSportsbooks",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SportsbookRow"
                  },
                  "type": "array",
                  "title": "Response Listsportsbooks"
                }
              }
            }
          }
        }
      }
    },
    "/api/sportsbooks/{key}": {
      "patch": {
        "tags": [
          "sportsbooks"
        ],
        "summary": "Patch Sportsbook",
        "operationId": "patchSportsbook",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SportsbookPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SportsbookRow"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/opportunities": {
      "get": {
        "tags": [
          "opportunities"
        ],
        "summary": "List Opportunities",
        "description": "Newest first. `status` and `type` are the §4.3 enums, validated by name so\na typo is a 422 rather than a silently empty table.",
        "operationId": "listOpportunities",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "open",
                    "alerted",
                    "closed",
                    "expired"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "ev",
                    "arb"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OpportunityRow"
                  },
                  "title": "Response Listopportunities"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/recommendations": {
      "get": {
        "tags": [
          "recommendations"
        ],
        "summary": "List Recommendations",
        "description": "History, with each row's opportunity and result joined in.\n\nElasticsearch has no joins, so this is two `mget`s over the ids the first\nquery returned — bounded by `limit` and therefore cheap, and far better than\nmaking the UI issue N+1 requests to assemble a table.",
        "operationId": "listRecommendations",
        "parameters": [
          {
            "name": "paper",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Paper"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecommendationRow"
                  },
                  "title": "Response Listrecommendations"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/recommendations/{recommendation_id}/confirm": {
      "post": {
        "tags": [
          "recommendations"
        ],
        "summary": "Confirm",
        "operationId": "confirmRecommendation",
        "parameters": [
          {
            "name": "recommendation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Recommendation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BetRow"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/results/summary": {
      "get": {
        "tags": [
          "results"
        ],
        "summary": "Summary",
        "description": "P&L, hit rate, average CLV, and the paper-versus-executed split per bucket.",
        "operationId": "getResultsSummary",
        "parameters": [
          {
            "name": "group",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "day",
                "week"
              ],
              "type": "string",
              "default": "day",
              "title": "Group"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/bankroll": {
      "get": {
        "tags": [
          "bankroll"
        ],
        "summary": "Read Bankroll",
        "description": "Total and per-book balances as sum aggregations, plus recent ledger rows.",
        "operationId": "getBankroll",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 200,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BankrollResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/bankroll/adjust": {
      "post": {
        "tags": [
          "bankroll"
        ],
        "summary": "Adjust",
        "description": "Append a manual ledger row. Deltas only — there is no balance to set.",
        "operationId": "adjustBankroll",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdjustBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerEntry"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/matching": {
      "get": {
        "tags": [
          "matching"
        ],
        "summary": "List Unmatched",
        "operationId": "listUnmatched",
        "parameters": [
          {
            "name": "resolved",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Resolved"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 200,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UnmatchedRowResponse"
                  },
                  "title": "Response Listunmatched"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/matching/{unmatched_id}/resolve": {
      "post": {
        "tags": [
          "matching"
        ],
        "summary": "Resolve",
        "operationId": "resolveUnmatched",
        "parameters": [
          {
            "name": "unmatched_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Unmatched Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnmatchedRowResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/kill": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Kill",
        "description": "Stop alerting. Polling continues, for data continuity (§7.1).",
        "operationId": "engageKillSwitch",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KillSwitchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/resume": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Resume",
        "operationId": "releaseKillSwitch",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KillSwitchResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdjustBody": {
        "properties": {
          "book_key": {
            "type": "string",
            "minLength": 1,
            "title": "Book Key"
          },
          "delta_cents": {
            "type": "integer",
            "title": "Delta Cents"
          },
          "reason": {
            "type": "string",
            "enum": [
              "deposit",
              "withdrawal",
              "manual_adjust"
            ],
            "title": "Reason",
            "default": "manual_adjust"
          }
        },
        "type": "object",
        "required": [
          "book_key",
          "delta_cents"
        ],
        "title": "AdjustBody"
      },
      "BankrollResponse": {
        "properties": {
          "total_cents": {
            "type": "integer",
            "title": "Total Cents"
          },
          "by_book": {
            "items": {
              "$ref": "#/components/schemas/BookBalance"
            },
            "type": "array",
            "title": "By Book"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/LedgerEntry"
            },
            "type": "array",
            "title": "Entries"
          }
        },
        "type": "object",
        "required": [
          "total_cents"
        ],
        "title": "BankrollResponse"
      },
      "BetRow": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "recommendation_id": {
            "type": "string",
            "title": "Recommendation Id"
          },
          "confirmed_via": {
            "type": "string",
            "title": "Confirmed Via"
          },
          "stake_actual_cents": {
            "type": "integer",
            "title": "Stake Actual Cents"
          },
          "odds_actual_decimal": {
            "type": "number",
            "title": "Odds Actual Decimal"
          },
          "placed_at": {
            "type": "string",
            "title": "Placed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "recommendation_id",
          "confirmed_via",
          "stake_actual_cents",
          "odds_actual_decimal",
          "placed_at"
        ],
        "title": "BetRow"
      },
      "BookBalance": {
        "properties": {
          "book_key": {
            "type": "string",
            "title": "Book Key"
          },
          "balance_cents": {
            "type": "integer",
            "title": "Balance Cents"
          }
        },
        "type": "object",
        "required": [
          "book_key",
          "balance_cents"
        ],
        "title": "BookBalance"
      },
      "ConfirmBody": {
        "properties": {
          "stake_actual_cents": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stake Actual Cents"
          },
          "odds_actual_decimal": {
            "type": "number",
            "exclusiveMinimum": 1.0,
            "title": "Odds Actual Decimal"
          }
        },
        "type": "object",
        "required": [
          "stake_actual_cents",
          "odds_actual_decimal"
        ],
        "title": "ConfirmBody",
        "description": "What the human actually got on the book."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "paper_mode": {
            "type": "boolean",
            "title": "Paper Mode"
          },
          "kill_switch": {
            "type": "boolean",
            "title": "Kill Switch"
          },
          "runtime": {
            "additionalProperties": true,
            "type": "object",
            "title": "Runtime"
          },
          "quota": {
            "items": {
              "$ref": "#/components/schemas/QuotaRow"
            },
            "type": "array",
            "title": "Quota"
          },
          "sports_enabled": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sports Enabled"
          }
        },
        "type": "object",
        "required": [
          "paper_mode",
          "kill_switch"
        ],
        "title": "HealthResponse"
      },
      "KillSwitchResponse": {
        "properties": {
          "kill_switch": {
            "type": "boolean",
            "title": "Kill Switch"
          }
        },
        "type": "object",
        "required": [
          "kill_switch"
        ],
        "title": "KillSwitchResponse"
      },
      "LedgerEntry": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "book_key": {
            "type": "string",
            "title": "Book Key"
          },
          "delta_cents": {
            "type": "integer",
            "title": "Delta Cents"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "ref_result_id": {
            "type": "string",
            "title": "Ref Result Id",
            "default": ""
          },
          "@timestamp": {
            "type": "string",
            "title": "@Timestamp"
          }
        },
        "type": "object",
        "required": [
          "id",
          "book_key",
          "delta_cents",
          "reason",
          "@timestamp"
        ],
        "title": "LedgerEntry"
      },
      "OpportunityLegRow": {
        "properties": {
          "book_key": {
            "type": "string",
            "title": "Book Key"
          },
          "selection": {
            "type": "string",
            "title": "Selection"
          },
          "line": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "price_decimal": {
            "type": "number",
            "title": "Price Decimal"
          },
          "devig_prob": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Devig Prob"
          },
          "staleness": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Staleness"
          },
          "bet_first": {
            "type": "boolean",
            "title": "Bet First",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "book_key",
          "selection",
          "price_decimal"
        ],
        "title": "OpportunityLegRow"
      },
      "OpportunityRow": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "market_key": {
            "type": "string",
            "title": "Market Key"
          },
          "legs": {
            "items": {
              "$ref": "#/components/schemas/OpportunityLegRow"
            },
            "type": "array",
            "title": "Legs"
          },
          "edge_pct": {
            "type": "number",
