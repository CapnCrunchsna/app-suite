{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noPropertyAccessFromIndexSignature": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "module": "preserve",
    // The workspace base targets Node libs and declaration-only emit (the three
    // ledgerline libs are consumed as types). Angular's compiler rejects
    // `emitDeclarationOnly` outright (NG4006) and the browser needs `dom`.
    // `nx typecheck` re-adds --emitDeclarationOnly on the command line.
    "emitDeclarationOnly": false,
    "lib": ["es2022", "dom"],
    // Angular libs must be compiled from source by the consuming app, not read
    // out of a sibling `dist/`. `@angular/build:unit-test` hardcodes
    // `externalPackages: true`, so a bare `@app-suite/…` specifier is left
    // external and Vite resolves it to the plain-`tsc` `dist/` — which has no
    // Angular metadata, gets JIT-compiled from the decorator alone, and
    // silently drops every `input()`/`output()`. A `paths` entry resolves to a
    // file rather than a package, so esbuild inlines the source and ngtsc
    // compiles it. Every workspace lib this app imports needs an entry here.
    "paths": {
      "@app-suite/ui-kit": ["../../libs/shared/ui-kit/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
