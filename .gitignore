# Dependencies
node_modules/

# Nx
.nx/cache
.nx/workspace-data

# Build output
dist/
tmp/
out-tsc/

# Test / coverage
coverage/
.angular/

# Local app data — Ledgerline keeps its SQLite file out of version control.
# It contains real financial statements and must never be committed.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
# Anchored to the workspace root on purpose. An unanchored `data/` matches any
# directory of that name at any depth, which silently swallowed the whole of
# `libs/ledgerline/data/` — Nx globs project files through .gitignore, so the
# lib did not exist as far as the project graph was concerned.
/data/

# Machine-local Claude Code settings (launch.json and skills/ ARE versioned)
.claude/settings.local.json

# Editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Nx tooling (added when the workspace was scaffolded)
.nx/polygraph
.nx/self-healing
.nx/migrate-runs
.claude/worktrees
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md
*.tsbuildinfo
npm-debug.log
yarn-error.log

vitest.config.*.timestamp*
.angular

__screenshots__/
