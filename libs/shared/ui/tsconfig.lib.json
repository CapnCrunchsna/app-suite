{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // `dist/` belongs to ng-packagr; `tsc` (the inferred `typecheck` target)
    // gets its own directory so the two never overwrite each other's
    // `index.d.ts`. ng-packagr ignores `outDir` and writes to ng-package.json's
    // `dest`.
    "outDir": "out-tsc/lib",
    "tsBuildInfoFile": "out-tsc/lib/tsconfig.lib.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "references": []
}
